#include <ESP8266WiFi.h>
#include <ESP8266WebServer.h>

/* -------- WiFi Credentials -------- */
const char* ssid = "YOUR_WIFI_NAME";
const char* password = "YOUR_WIFI_PASSWORD";

/* -------- Motor Pins (L298N) -------- */
#define IN1 D1
#define IN2 D2
#define IN3 D3
#define IN4 D4
#define ENA D5
#define ENB D6

/* -------- Sensor Pins -------- */
#define TRIG D7
#define ECHO D8
#define PIR  D0
#define GAS  A0

ESP8266WebServer server(80);

/* -------- HTML Web Page -------- */
String webpage = R"=====(
<!DOCTYPE html>
<html>
<head>
<title>IoT Smart Bot Car</title>
<style>
body{font-family:Arial;text-align:center;background:#f2f2f2;}
button{padding:15px 30px;margin:10px;font-size:18px;}
</style>
</head>
<body>
<h2>IoT Smart Bot Car Control</h2>

<button onclick="sendCmd('F')">Forward</button><br>
<button onclick="sendCmd('L')">Left</button>
<button onclick="sendCmd('S')">Stop</button>
<button onclick="sendCmd('R')">Right</button><br>
<button onclick="sendCmd('B')">Backward</button>

<script>
function sendCmd(cmd){
  fetch("/control?cmd=" + cmd);
}
</script>
</body>
</html>
)=====";

/* -------- Motor Control Functions -------- */
void stopMotor(){
  digitalWrite(IN1,LOW); digitalWrite(IN2,LOW);
  digitalWrite(IN3,LOW); digitalWrite(IN4,LOW);
}

void forward(){
  digitalWrite(IN1,HIGH); digitalWrite(IN2,LOW);
  digitalWrite(IN3,HIGH); digitalWrite(IN4,LOW);
}

void backward(){
  digitalWrite(IN1,LOW); digitalWrite(IN2,HIGH);
  digitalWrite(IN3,LOW); digitalWrite(IN4,HIGH);
}

void left(){
  digitalWrite(IN1,LOW); digitalWrite(IN2,HIGH);
  digitalWrite(IN3,HIGH); digitalWrite(IN4,LOW);
}

void right(){
  digitalWrite(IN1,HIGH); digitalWrite(IN2,LOW);
  digitalWrite(IN3,LOW); digitalWrite(IN4,HIGH);
}

/* -------- Sensor Functions -------- */
long getDistance(){
  digitalWrite(TRIG, LOW);
  delayMicroseconds(2);
  digitalWrite(TRIG, HIGH);
  delayMicroseconds(10);
  digitalWrite(TRIG, LOW);
  long duration = pulseIn(ECHO, HIGH);
  return duration * 0.034 / 2;
}

/* -------- Web Server Handlers -------- */
void handleRoot(){
  server.send(200, "text/html", webpage);
}

void handleControl(){
  String cmd = server.arg("cmd");

  if(cmd == "F") forward();
  else if(cmd == "B") backward();
  else if(cmd == "L") left();
  else if(cmd == "R") right();
  else stopMotor();

  server.send(200, "text/plain", "OK");
}

void setup(){
  Serial.begin(9600);

  pinMode(IN1,OUTPUT); pinMode(IN2,OUTPUT);
  pinMode(IN3,OUTPUT); pinMode(IN4,OUTPUT);
  pinMode(ENA,OUTPUT); pinMode(ENB,OUTPUT);

  pinMode(TRIG,OUTPUT);
  pinMode(ECHO,INPUT);
  pinMode(PIR,INPUT);

  analogWrite(ENA,200);
  analogWrite(ENB,200);

  WiFi.begin(ssid, password);
  Serial.print("Connecting");
  while(WiFi.status() != WL_CONNECTED){
    delay(500);
    Serial.print(".");
  }

  Serial.println("\nConnected!");
  Serial.println(WiFi.localIP());

  server.on("/", handleRoot);
  server.on("/control", handleControl);
  server.begin();
}

void loop(){
  server.handleClient();

  long distance = getDistance();
  int gasValue = analogRead(GAS);

  if(distance < 20){
    stopMotor();   // obstacle detected
  }

  if(digitalRead(PIR) == HIGH){
    Serial.println("Motion Detected!");
  }

  if(gasValue > 400){
    Serial.println("Gas Leakage Alert!");
  }
}
